# Скопируй в .env и поменяй значения

# Порт API
PORT=3000

# ——— База данных ———
# Строка подключения: postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
# Подробно — docs/database.md
#
# Локальный Postgres без установки (npm run db:local):
DATABASE_URL=postgres://postgres@localhost:5432/postgres
#
# Настоящий Postgres (на сервере или когда появится свой):
# DATABASE_URL=postgres://stand:пароль@localhost:5432/stand

# Сколько соединений с базой держит сервер
DB_POOL_MAX=5

# Только для Postgres из docker-compose: с этими данными контейнер создаст
# пользователя и базу при первом запуске. DATABASE_URL для контейнера
# собирается из них сам (см. docker-compose.yml).
POSTGRES_USER=stand
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stand

# ——— Данные стенда ———
# Папка с деревом тематик и сценариями
DATA_DIR=./data

# ——— Сессии ———
# Секрет для подписи cookie сессии — длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Время жизни сессии в часах
SESSION_TTL_HOURS=12

# true только если стенд открывается по HTTPS. По HTTP оставь false, иначе вход не будет работать
COOKIE_SECURE=false

# ——— Первый руководитель (npm run db:seed) ———
SEED_MANAGER_LOGIN=manager
SEED_MANAGER_PASSWORD=change-me
