{
  "$comment": "Пример диалогов. Каждый оператор проходит все сценарии в случайном порядке. expectedLeafId — id конечной тематики (узел без детей, любой глубины) из дерева: эталон, с которым сравнивается выбор оператора. Свои диалоги положи в data/scenarios.json — он в .gitignore.",
  "scenarios": [
    {
      "id": "s1",
      "title": "Курьер опаздывает",
      "clientName": "Анна",
      "messages": [
        {
          "from": "client",
          "text": "Здравствуйте! Обещали привезти за 15 минут, прошло уже 40. На карте курьер стоит на месте.",
          "time": "19:42"
        },
        {
          "from": "operator",
          "text": "Здравствуйте! Сейчас разберусь, одну минуту.",
          "time": "19:43"
        }
      ],
      "expectedLeafId": "t-delivery-late"
    },
    {
      "id": "s2",
      "title": "Промокод не сработал",
      "clientName": "Дмитрий",
      "messages": [
        {
          "from": "client",
          "text": "Собираю заказ, ввёл промокод из рассылки на 300 ₽, а сумма к оплате не изменилась. Что не так?",
          "time": "10:05"
        },
        {
          "from": "operator",
          "text": "Здравствуйте! Сейчас разберусь, одну минуту.",
          "time": "10:06"
        }
      ],
      "expectedLeafId": "t-checkout-promo"
    },
    {
      "id": "s3",
      "title": "Не положили йогурт",
      "clientName": "Ольга",
      "messages": [
        {
          "from": "client",
          "text": "Привезли заказ, а йогурта, за который я заплатила, в пакете нет.",
          "time": "13:27"
        },
        {
          "from": "operator",
          "text": "Здравствуйте! Сейчас разберусь, одну минуту.",
          "time": "13:28"
        }
      ],
      "expectedLeafId": "t-content-missing"
    },
    {
      "id": "s4",
      "title": "Деньги не вернулись",
      "clientName": "Мария",
      "messages": [
        {
          "from": "client",
          "text": "Неделю назад отменила заказ, обещали вернуть деньги, но на карту так ничего и не пришло.",
          "time": "16:10"
        },
        {
          "from": "operator",
          "text": "Здравствуйте! Сейчас разберусь, одну минуту.",
          "time": "16:11"
        }
      ],
      "expectedLeafId": "t-refund-late"
    },
    {
      "id": "s5",
      "title": "Заказал по ошибке",
      "clientName": "Сергей",
      "messages": [
        {
          "from": "client",
          "text": "Оформил заказ случайно, его ещё не привезли. Можно его отменить?",
          "time": "21:58"
        },
        {
          "from": "operator",
          "text": "Здравствуйте! Сейчас разберусь, одну минуту.",
          "time": "21:59"
        }
